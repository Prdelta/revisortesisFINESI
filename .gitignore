# Archivos compilados y temporales de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
env/
.venv/

# Archivos de PyInstaller (Compilación del ejecutable)
# El .spec SÍ se versiona: es la receta de compilación, no un artefacto.
build/
dist/

# Candados de Word. Word crea '~$documento.docx' mientras un archivo está abierto,
# y eso pasa dentro de carpetas versionadas como ejemplos/. El programa ya los saltea
# al revisar (ver expandir() y _sumar()); acá se saltean al versionar.
~$*

# Logs y reportes generados por la app
data/reportes/
*.log

# Datos del revisor que se editan en cada equipo.
# registro.csv y mis_reglas.yaml SÍ se versionan a propósito: el repo trae la plantilla
# de partida y el programa la copia si falta. Si en tu instalación el registro lleva
# nombres reales de tesistas y asesores, descomentá la línea siguiente.
# data/registro.csv

# Configuración local de la app (la escribe AppConfig en data/)
data/config.json

# Cache de herramientas
.pytest_cache/
.ruff_cache/

# Las instantáneas de tests/instantaneas/ SÍ se versionan aunque las genere un comando:
# son la referencia contra la que se compara cada corrida. Sin ellas los tests de
# caracterización no tienen con qué comparar.

# Corpus de calibracion: son tesis reales de estudiantes, no se versionan
corpus/

# Archivos del IDE o SO
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Salida del instalador (Inno Setup)
instalador/salida/
