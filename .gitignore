# Archivos compilados y temporales de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
env/
.venv/

# Archivos de PyInstaller (Compilación del ejecutable)
# El .spec SÍ se versiona: es la receta de compilación, no un artefacto.
build/
dist/

# Archivos temporales de la base de datos o registro (opcional, comentar si se quiere subir)
# registro.csv

# Logs y reportes generados por la app
data/reportes/
*.log

# Cache de pytest
.pytest_cache/

# Corpus de calibracion: son tesis reales de estudiantes, no se versionan
corpus/

# Archivos del IDE o SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# Configuración local de la app
config.json
